# Choose one or both LLM providers.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Google embeddings. Recommended model for multilingual/cross-source retrieval.
GOOGLE_API_KEY=
# Gemini Developer API: use short id (see https://ai.google.dev/gemini-api/docs/embeddings)
EMBEDDING_MODEL=gemini-embedding-001

# Reasoning defaults. Free model availability changes, so override per environment.
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
GROQ_MODEL=llama-3.1-8b-instant

# Logging: DEBUG shows per-agent steps; INFO is quieter.
SDLC_LOG_LEVEL=INFO

# Local open-source voice input (pip install -e ".[whisper]")
WHISPER_MODEL=base

# LangGraph conditional routing (set to true to activate).
USE_LANGGRAPH=false
# Agents with confidence below this threshold trigger the feedback_refinement detour.
CONFIDENCE_THRESHOLD=0.6

# Prompt size limits (raise when using models with larger context; Groq free ~6k TPM/request).
MAX_CONTEXT_CHARS=6000
MAX_CONTEXT_CHUNKS=8
MAX_PRIOR_AGENTS=3
MAX_PRIOR_OUTPUT_CHARS=800

# Runtime storage.
CHROMA_PERSIST_DIR=.data/chroma
ARTIFACT_DIR=.data/artifacts
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=120

# Optional integrations.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_TOKEN=
